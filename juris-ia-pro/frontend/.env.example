# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_API_PREFIX=/api/v1

# App Configuration
NEXT_PUBLIC_APP_NAME=JurisIA Pro
NEXT_PUBLIC_APP_VERSION=1.0.0
