# ========================================
# BANCO DE DADOS (PostgreSQL)
# ========================================
POSTGRES_USER=juris_user
POSTGRES_PASSWORD=be558f126e906bcf3f99246a87b1b413
POSTGRES_DB=juris_ia_pro
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# URL completa do banco
DATABASE_URL=postgresql://juris_user:be558f126e906bcf3f99246a87b1b413@postgres:5432/juris_ia_pro

# ========================================
# CACHE (Redis)
# ========================================
REDIS_PASSWORD=44d927641580ca2d0c6e24aece113dd6
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# URL completa do Redis
REDIS_URL=redis://:44d927641580ca2d0c6e24aece113dd6@redis:6379/0

# ========================================
# VECTOR DATABASE (Qdrant)
# ========================================
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION_NAME=documentos_juridicos

# ========================================
# OPENAI API
# ========================================
# ⚠️ ADICIONE SUA CHAVE AQUI:
# Como obter: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-COLE_SUA_CHAVE_OPENAI_AQUI

# Configurações OpenAI
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=4000
OPENAI_TEMPERATURE=0.3

# ========================================
# SEGURANÇA
# ========================================
SECRET_KEY=8e0d385d42e3e3deb91a93aeaa7a53cee1251753b908d70dd29f84cdb1ee516e

# CORS - Domínios permitidos (para desenvolvimento local)
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://127.0.0.1:8000

# Para produção, substitua por seu domínio:
# CORS_ORIGINS=https://seudominio.com,https://www.seudominio.com,https://api.seudominio.com

# ========================================
# FRONTEND (Next.js)
# ========================================
# URL do backend que o frontend vai usar
NEXT_PUBLIC_API_URL=http://localhost:8000

# Para produção, substitua por:
# NEXT_PUBLIC_API_URL=https://api.seudominio.com

# ========================================
# CONFIGURAÇÕES DA APLICAÇÃO
# ========================================
# Ambiente
NODE_ENV=production
PYTHON_ENV=production

# Cache TTL (tempo de vida em segundos)
CACHE_TTL_SECONDS=300
CACHE_TTL_SEARCH=600
CACHE_TTL_CHAT=300
CACHE_TTL_KEYWORDS=3600

# RAG (Retrieval Augmented Generation)
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=3000

# PDF Processing
MAX_PDF_SIZE_MB=10
PDF_ALLOWED_EXTENSIONS=pdf

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# ========================================
# OPCIONAL: Analytics e Monitoring
# ========================================
# Descomente e configure se quiser usar:

# Sentry (Error tracking)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Google Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# PostHog (Product Analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxx
# NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ============================================
# INSTRUÇÕES DE USO:
# ============================================
#
# 1. ADICIONE SUA OPENAI_API_KEY na linha 50
#    - Obtenha em: https://platform.openai.com/api-keys
#    - Formato: sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# 2. RENOMEIE este arquivo:
#    mv .env.production.READY .env.production
#
# 3. EXECUTE O DEPLOY:
#    chmod +x deploy.sh
#    ./deploy.sh
#    (Escolha opção 1: Deploy completo)
#
# 4. AGUARDE 10-20 minutos para build
#
# 5. ACESSE:
