# ====================================
# JURISIA PRO - ENVIRONMENT VARIABLES
# ====================================

# ----------- APPLICATION -----------
APP_NAME=JurisIA Pro
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# ----------- API CONFIGURATION -----------
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_RELOAD=true

# CORS
CORS_ORIGINS=["http://localhost:3000", "http://127.0.0.1:3000"]

# ----------- DATABASE -----------
# PostgreSQL
DATABASE_URL=postgresql://jurisia_user:jurisia_pass_2024@localhost:5432/jurisia_db
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10

# ----------- VECTOR DATABASE -----------
# Qdrant
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=legal_documents

# ----------- REDIS -----------
REDIS_URL=redis://:jurisia_redis_2024@localhost:6379/0
REDIS_MAX_CONNECTIONS=50

# ----------- AI/ML CONFIGURATION -----------
# OpenAI
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4-turbo-preview
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MAX_TOKENS=2000
OPENAI_TEMPERATURE=0.1

# Alternative: Azure OpenAI
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_DEPLOYMENT_NAME=

# Alternative: Anthropic Claude
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-3-opus-20240229

# ----------- EMBEDDING SETTINGS -----------
EMBEDDING_DIMENSION=3072
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# ----------- RAG CONFIGURATION -----------
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.7
RAG_MAX_CONTEXT_LENGTH=8000

# ----------- CELERY TASKS -----------
CELERY_BROKER_URL=redis://:jurisia_redis_2024@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:jurisia_redis_2024@localhost:6379/1

# ----------- SCRAPING CONFIGURATION -----------
SCRAPING_ENABLED=true
SCRAPING_SCHEDULE_HOURS=24
SCRAPING_CONCURRENT_REQUESTS=5
SCRAPING_USER_AGENT=JurisIA-Bot/1.0

# Fontes Jurídicas
SCRAPE_STF=true
SCRAPE_STJ=true
SCRAPE_TST=true
SCRAPE_TJSP=true
SCRAPE_TJRJ=true
SCRAPE_DOU=true
SCRAPE_PLANALTO=true

# ----------- SECURITY -----------
# JWT
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Password Hashing
BCRYPT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_BURST=20

# ----------- FILE UPLOAD -----------
MAX_UPLOAD_SIZE_MB=20
ALLOWED_EXTENSIONS=["pdf", "doc", "docx"]
UPLOAD_DIR=./uploads

# ----------- STORAGE -----------
# Local or S3
STORAGE_TYPE=local
STORAGE_PATH=./storage

# AWS S3 (if using)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_BUCKET_NAME=jurisia-documents

# ----------- MONITORING -----------
ENABLE_METRICS=true
METRICS_PORT=9090

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# ----------- EMAIL (for notifications) -----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@jurisia.com.br

# ----------- EXTERNAL SERVICES -----------
# Captcha (opcional)
RECAPTCHA_SECRET_KEY=

# Analytics (opcional)
GOOGLE_ANALYTICS_ID=

# ----------- LEGAL DATA SOURCES -----------
# STF
STF_API_URL=https://portal.stf.jus.br/jurisprudencia/
STF_API_KEY=

# STJ
STJ_API_URL=https://scon.stj.jus.br/
STJ_API_KEY=

# DOU
DOU_API_URL=https://www.in.gov.br/servicos/diario-oficial-da-uniao

# Planalto
PLANALTO_API_URL=https://www.planalto.gov.br/ccivil_03/leis/

# ----------- FEATURE FLAGS -----------
ENABLE_CHAT=true
ENABLE_DOCUMENT_GENERATION=true
ENABLE_PDF_ANALYSIS=true
ENABLE_LEGAL_ALERTS=true

# ----------- PERFORMANCE -----------
CACHE_TTL_SECONDS=3600
QUERY_TIMEOUT_SECONDS=30
MAX_CONCURRENT_REQUESTS=100

# ----------- DEVELOPMENT -----------
# Apenas para desenvolvimento local
DEV_AUTO_RELOAD=true
DEV_MOCK_AI=false
DEV_SAMPLE_DATA=true

# ----------- TESTING -----------
TEST_DATABASE_URL=postgresql://jurisia_user:jurisia_pass_2024@localhost:5432/jurisia_test_db
PYTEST_WORKERS=4
