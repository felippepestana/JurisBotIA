# ============================================
# JURISIA PRO - PRODUÇÃO
# ============================================

# PostgreSQL
POSTGRES_USER=juris_user
POSTGRES_PASSWORD=CHANGE_THIS_SECURE_PASSWORD_123
POSTGRES_DB=juris_ia_pro

# Redis
REDIS_PASSWORD=CHANGE_THIS_REDIS_PASSWORD_456

# OpenAI (OBRIGATÓRIO)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Security
SECRET_KEY=CHANGE_THIS_TO_RANDOM_SECURE_STRING_789
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Frontend
NEXT_PUBLIC_API_URL=https://api.yourdomain.com

# Optional: Analytics, Monitoring
# SENTRY_DSN=
# GOOGLE_ANALYTICS_ID=

# ============================================
# INSTRUÇÕES:
# 1. Copie este arquivo para .env.production
# 2. Altere TODOS os valores CHANGE_THIS
# 3. Configure sua OPENAI_API_KEY
# 4. Atualize CORS_ORIGINS e NEXT_PUBLIC_API_URL
# 5. NUNCA commite o arquivo .env.production!
# ============================================
